{
  "name": "anlat-hoca",
  "version": "0.0.0",
  "private": true,
  "description": "Anlat Hoca mobile study application monorepo",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @anlat-hoca/mobile start",
    "dev:api": "pnpm --filter @anlat-hoca/api dev",
    "db:migrate:local": "pnpm --filter @anlat-hoca/api db:migrate:local",
    "db:migrations:list:local": "pnpm --filter @anlat-hoca/api db:migrations:list:local",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "deploy:api": "pnpm --filter @anlat-hoca/api run deploy",
    "db:migrate:remote": "pnpm --filter @anlat-hoca/api db:migrate:remote",
    "db:migrations:list:remote": "pnpm --filter @anlat-hoca/api db:migrations:list:remote"
  }
}
