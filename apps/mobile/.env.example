# Physical Android devices usually cannot reach the development computer through localhost.
# Use your computer's LAN IP while the phone and computer are on the same network.
# Android Emulator commonly uses 10.0.2.2; production will later use the Worker HTTPS URL.
# EXPO_PUBLIC_ values are embedded in the client bundle. Never put secrets here.
EXPO_PUBLIC_API_BASE_URL=http://YOUR_COMPUTER_LAN_IP:8787
