{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anlat-hoca-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["GEMINI_API_KEY"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
